{
  "name": "pimcore/object-merger",
  "type": "pimcore-bundle",
  "license": "Pimcore Open Core License (POCL)",
  "config": {
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "Pimcore\\Bundle\\ObjectMergerBundle\\": "src"
    }
  },
  "prefer-stable": true,
  "minimum-stability": "dev",
  "require": {
    "php": "~8.3.0 || ~8.4.0",
    "pimcore/pimcore": "^12.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^1.12.15"
  },
  "extra": {
    "pimcore": {
      "bundles": [
        "Pimcore\\Bundle\\ObjectMergerBundle\\ObjectMergerBundle"
      ]
    } 
  }
}
