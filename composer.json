{
  "name": "pimcore/object-merger",
  "type": "pimcore-bundle",
  "license": "proprietary",
  "config": {
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "Pimcore\\Bundle\\ObjectMergerBundle\\": "src"
    }
  },
  "prefer-stable": true,
  "minimum-stability": "dev",
  "require": {
    "php": "~8.4.0 || ~8.5.0",
    "pimcore/pimcore": "^2026.1"
  },
  "require-dev": {
    "phpstan/phpstan": "^1.12.15"
  },
  "extra": {
    "branch-alias": {
      "dev-2026.x": "2026.1.x-dev"
    },
    "pimcore": {
      "bundles": [
        "Pimcore\\Bundle\\ObjectMergerBundle\\ObjectMergerBundle"
      ]
    } 
  }
}
